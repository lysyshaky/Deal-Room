# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key (NOT the anon key). Server-side only — never shipped to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional. If set, /dashboard asks for this passcode. Leave empty to keep the dashboard open.
ADMIN_PASSCODE=
